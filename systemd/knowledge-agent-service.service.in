[Unit]
Description=Knowledge Agent layered memory service
Documentation=file://@PROJECT_DIR@/README.md
After=network.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/knowledge-agent-service/environment
ExecStart=@PROJECT_DIR@/scripts/run-service.sh
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictSUIDSGID=true

[Install]
WantedBy=default.target